generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum DealStatus {
  WATCHING
  INQUIRED
  NEGOTIATING
  LOI
  NOTAR
  CLOSED
  REJECTED
}

enum DealType {
  FREE_SALE
  AUCTION
}

enum AuctionType {
  ZVG
  DGA
  SDL
  KARHAUSEN
  OTHER
}

enum MarketRating {
  below_market
  fair
  above_market
}

enum UserRole {
  INVESTOR
  SELLER
  BOTH
  BROKER
  LANDLORD
  TENANT
}

// Phase H1 — Coin-System: alle Earn-/Spend-Kinds.
// Earn-Kinds haben positive amounts, SPEND_-Kinds negative amounts.
enum CoinTxKind {
  PROFILE_COMPLETED
  LISTING_ACTIVATED
  SELLER_CONTACTED
  DAILY_LOGIN
  REFERRAL_BROKER_ONBOARDED
  SPEND_LISTING_HIGHLIGHT
  SPEND_PROFILE_BOOST
  SPEND_FEED_BOOST
  ADMIN_ADJUSTMENT
}

// Phase J1 — Verkaufsabwicklung: Stationen vom akzeptierten Lead bis
// zur Eigentumsumschreibung. ABGEBROCHEN ist der Off-Track-Endzustand
// (z.B. Finanzierung geplatzt) — Verkäufer kann dann einen neuen
// SaleProcess für dasselbe Listing starten.
enum SaleStage {
  ANFRAGE_AKZEPTIERT
  BESICHTIGUNG
  VERHANDLUNG
  RESERVIERUNG_LOI
  NOTARENTWURF
  NOTARTERMIN
  BEURKUNDET
  AUFLASSUNGSVORMERKUNG
  KAUFPREISZAHLUNG
  UEBERGABE
  EIGENTUMSUMSCHREIBUNG
  ABGESCHLOSSEN
  ABGEBROCHEN
}

// Phase K — KI-Bewertungen.
//   SaleSpeed:     erwartete Verkaufsgeschwindigkeit
//   DemandLevel:   Nachfrageniveau am Markt
//   OfferAttractiveness: Bewertung eines konkreten Kaeufer-Angebots
//   OfferRecommendation: Handlungsempfehlung dazu
enum SaleSpeed {
  FAST
  NORMAL
  DIFFICULT
}

enum DemandLevel {
  HIGH
  MEDIUM
  LOW
}

enum OfferAttractiveness {
  SEHR_ATTRAKTIV
  MARKTGERECHT
  NIEDRIG
  UNREALISTISCH
}

enum OfferRecommendation {
  AKZEPTIEREN
  GEGENANGEBOT
  ABLEHNEN
}

// Phase L — Vermietung.
//   RentalStatus:       Lebenszyklus eines Mietobjekts
//   ApplicationStatus:  Lebenszyklus einer Bewerbung
//   ApplicantRating:    KI-Einschaetzung (NICHT als Entscheidung,
//                       nur als organisatorische Unterstuetzung).
enum RentalStatus {
  DRAFT
  AVAILABLE
  RESERVED
  RENTED
  ARCHIVED
}

enum ApplicationStatus {
  NEW
  REVIEWING
  VIEWING
  ACCEPTED
  REJECTED
  WITHDRAWN
}

enum ApplicantRating {
  SEHR_PASSEND
  PASSEND
  BEDINGT_PASSEND
  EHER_UNPASSEND
}

// Phase J1 — Dokumenten-Kategorien rund um den Immobilienverkauf.
// Pro Process+Kind genau ein Dokument (Re-Upload ueberschreibt).
// "SONSTIGES" ist der Catch-all fuer alles was nicht passt.
// Phase M3 — Notification-Typen.
// FIRST_BUYER_ACCESS: erster Token-Abruf einer BuyerDocAccess
// FUTURE_*: Platzhalter, falls Marco spaeter weitere Events einbaut
enum UserNotificationKind {
  FIRST_BUYER_ACCESS
  REPEAT_BUYER_ACCESS
  INQUIRY_RECEIVED
  SALE_STAGE_CHANGED
}

enum SaleDocKind {
  GRUNDBUCH
  ENERGIEAUSWEIS
  FLURKARTE
  GRUNDRISS
  WOHNFLAECHENBERECHNUNG
  KAUFVERTRAG_ENTWURF
  KAUFVERTRAG_BEURKUNDET
  VORFAELLIGKEITSSCHREIBEN
  AUFLASSUNGSVORMERKUNG
  UEBERGABEPROTOKOLL
  TEILUNGSERKLAERUNG
  EIGENTUEMERVERSAMMLUNG_PROTOKOLL
  MIETVERTRAEGE
  MIETAUFSTELLUNG
  NEBENKOSTENABRECHNUNG
  GRUNDSTEUERBESCHEID
  GEBAEUDEVERSICHERUNG
  MAKLERVERTRAG
  SONSTIGES
}

enum AssetType {
  MFH
  COMMERCIAL
  MIXED_USE
  SINGLE_FAMILY
  APARTMENT
  LAND
  OTHER
}

enum ProfileVisibility {
  PRIVATE
  ON_REQUEST
  PUBLIC
}

enum TrackrecordRole {
  BUYER
  SELLER
  PARTNER
  BROKER
  OTHER
}

enum ListingStatus {
  DRAFT
  ACTIVE
  IN_NEGOTIATION
  SOLD
  ARCHIVED
}

enum AnonymizationLevel {
  FULL_ADDRESS
  DISTRICT_ONLY
  CITY_ONLY
}

// Zustand der Bausubstanz — relevant für Modernisierungs-Einschätzung.
enum BuildingCondition {
  NEW                // Erstbezug nach Sanierung / Neubau
  REFURBISHED        // Kernsaniert
  MODERNIZED         // Modernisiert (Heizung, Fenster, Bäder)
  MAINTAINED         // Gepflegt, ohne grossen Stau
  NEEDS_RENOVATION   // Sanierungsbedürftig
}

// Energieausweis-Klasse (GEG/EnEV-konforme Skala).
// "A_PLUS" weil "+" in Prisma-Enums nicht erlaubt ist.
enum EnergyClass {
  A_PLUS
  A
  B
  C
  D
  E
  F
  G
  H
}

// Primärer Energieträger der Heizung.
enum EnergyCarrier {
  GAS
  OIL
  ELECTRIC
  DISTRICT_HEATING   // Fernwärme
  HEAT_PUMP          // Wärmepumpe
  PELLETS
  WOOD
  SOLAR
  OTHER
}

enum InquiryStatus {
  PENDING
  ACCEPTED
  REJECTED
  WITHDRAWN
}

enum RatingDirection {
  INVESTOR_TO_SELLER
  SELLER_TO_INVESTOR
}

// Subscription-Plan eines Users (Stripe-gestützt).
enum UserPlan {
  FREE
  INVESTOR_PRO
  SELLER_PRO
}

// Phase O — Oikos Capital Layer: persistente Finanzierungsanfrage.
// Lebenszyklus eines Finanzierungsvorgangs vom Anlegen bis zur Zusage/Absage.
enum FinancingRequestStatus {
  OFFEN              // gerade angelegt
  IN_VORBEREITUNG    // Unterlagen werden zusammengestellt
  BEREIT             // bankfähig, bereit zur Einreichung
  AN_PARTNER         // an Finanzierungspartner übergeben
  ZUGESAGT           // Finanzierung zugesagt
  ABGELEHNT          // abgelehnt / nicht weiterverfolgt
}

// Phase P — Partnerökosystem. Typ eines Finanzierungspartners.
enum FinancingPartnerType {
  BANK
  SPARKASSE
  VOLKSBANK
  VERMITTLER          // Finanzierungsvermittler (§ 34i/§ 34c GewO)
  SPEZIALFINANZIERER
  DEBT_FONDS
}

model User {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  clerkId   String   @unique
  email     String
  name      String?
  role      UserRole @default(INVESTOR)

  onboardingCompletedAt DateTime?

  // --- Subscription / Stripe (Phase G1) ---
  plan                 UserPlan  @default(FREE)
  planValidUntil       DateTime? // Ende der bezahlten Periode; null = nie aktiv gewesen
  stripeCustomerId     String?   @unique
  stripeSubscriptionId String?   @unique

  // --- Coin-System (Phase H1) ---
  // coinsBalance ist denormalisiert; Quelle der Wahrheit ist sum(CoinTransaction.amount).
  // Die earn/spend-Helpers in lib/coins.ts halten beide synchron in einer DB-Transaktion.
  coinsBalance Int     @default(0)
  // Erste 100 BROKER-User bekommen +50 % auf alle Earn-Events (dauerhaft).
  isEarlyBird  Boolean @default(false)
  // Admin-Flag für /admin/coins-Dashboard. Default false; manuell via SQL setzen.
  isAdmin      Boolean @default(false)
  // Self-Referral: User wurde von einem anderen User geworben.
  referredById String?
  referredBy   User?   @relation("UserReferrals", fields: [referredById], references: [id])
  referrals    User[]  @relation("UserReferrals")

  properties        Property[]
  investorProfile   InvestorProfile?
  trackrecordItems  TrackrecordItem[]
  listings          Listing[]
  inquiriesSent     Inquiry[] @relation("InvestorInquiries")
  ratingsGiven      Rating[]  @relation("RatingsGiven")
  ratingsReceived   Rating[]  @relation("RatingsReceived")
  coinTransactions  CoinTransaction[]
  coinSpends        CoinSpend[]
  saleProcessesAsSeller SaleProcess[]    @relation("SellerProcesses")
  saleProcessesAsBuyer  SaleProcess[]    @relation("BuyerProcesses")
  saleStageEntries      SaleStageEntry[] @relation("StageBy")
  uploadedSaleDocs      SaleDocument[]   @relation("DocUploads")
  buyerAccessGranted    BuyerDocAccess[] @relation("BuyerAccessSeller")
  buyerAccessReceived   BuyerDocAccess[] @relation("BuyerAccessBuyer")
  notifications         UserNotification[]
  rentalUnits           RentalUnit[]
  rentalApplicationsSent RentalApplication[] @relation("RentalApplicationsSent")
  tenantProfile         TenantProfile?

  // --- Phase F (Offmarket-Layer) ---
  offmarketLeads        OffmarketLead[]     @relation("OffmarketLeadOwner")
  offmarketInvitesSent  OffmarketInvite[]   @relation("OffmarketInvitesSentByOwner")
  offmarketInvitesRecv  OffmarketInvite[]   @relation("OffmarketInvitesReceivedByInvestor")
  offmarketMessages     OffmarketMessage[]  @relation("OffmarketMessageSender")

  // Phase O — Capital Layer
  financingRequests     FinancingRequest[]

  @@index([referredById])
}

// Phase H1 — Coin-Buchung (Earn oder Spend).
// Idempotenz via @@unique(userId, kind, refId): zweimaliger Versuch
// für dieselbe Quelle (z.B. dasselbe Listing aktivieren) wird stillschweigend
// ignoriert. refId-Konventionen:
//   PROFILE_COMPLETED         -> "self"
//   LISTING_ACTIVATED         -> Listing.id
//   SELLER_CONTACTED          -> Inquiry.id
//   DAILY_LOGIN               -> "YYYY-MM-DD" (UTC)
//   REFERRAL_BROKER_ONBOARDED -> referred User.id
//   SPEND_*                   -> CoinSpend.id (Backreferenz, optional)
//   ADMIN_ADJUSTMENT          -> freier Audit-String
model CoinTransaction {
  id        String     @id @default(cuid())
  createdAt DateTime   @default(now())

  userId    String
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  kind      CoinTxKind
  amount    Int        // positiv = Earn, negativ = Spend
  refId     String?    // s. Konventionen oben

  // Optional: kurzer Audit-Hinweis (z.B. "early-bird +50%")
  note      String?

  @@unique([userId, kind, refId], name: "uniq_coin_tx_idempotent")
  @@index([userId, createdAt])
  @@index([kind, createdAt])
}

// Phase H1 — Aktive Coin-Spend (zeitlich befristete Sichtbarkeits-Buchung).
// Wird beim Spend angelegt; Sortier-/Render-Layer fragen
// "validUntil > now()" gegen kind und ggf. targetId ab.
model CoinSpend {
  id         String     @id @default(cuid())
  createdAt  DateTime   @default(now())

  userId     String
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Nur SPEND_*-Kinds erlaubt (im Backend per Zod erzwungen).
  kind       CoinTxKind
  // Bei SPEND_LISTING_HIGHLIGHT: Listing.id (sonst null).
  targetId   String?
  validUntil DateTime

  @@index([userId, validUntil])
  @@index([kind, validUntil])
  @@index([targetId, validUntil])
}

model InvestorProfile {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Selbstdarstellung
  bio                       String?
  investmentExperienceYears Int      @default(0)

  // Bonität (alle in EUR; nullable, weil User es schrittweise füllt)
  equity        Int?
  monthlyIncome Int?
  monthlyDebt   Int?

  // Finanzierungs-Status
  financingPreApproved Boolean @default(false)
  financingNote        String? // z. B. "Bankzusage Sparkasse Berlin, gültig bis Q4/2026"

  // Präferenzen — als String[] gespeichert für Flexibilität
  preferredAssetTypes AssetType[] @default([])
  preferredRegions    String[]    @default([]) // z. B. ["Berlin", "10115", "NRW"]
  minTicketSize       Int?        // EUR — Untergrenze interessanter Deals
  maxTicketSize       Int?        // EUR — Obergrenze (max Investment)

  visibility ProfileVisibility @default(PRIVATE)
}

model TrackrecordItem {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  type        AssetType
  year        Int             // Jahr des Deals
  value       Int?            // Kaufpreis bzw. Volumen in EUR (optional, kann anonym bleiben)
  location    String          // z. B. "Berlin, Charlottenburg" oder "NRW"
  role        TrackrecordRole
  description String?         // 1–3 Sätze Kontext
  verifiedBy  String?         // optionale Verifikation, z. B. Notar-Aktenzeichen

  @@index([userId, year])
}

// Phase L8 — Mieter-Profil. Strikt AGG-konform:
// keine sensiblen Merkmale (Herkunft, Religion, Familienstand, Geschlecht,
// Behinderung, Alter etc.). Felder sind organisatorisch + wirtschaftlich
// und werden vom Mieter selbst gepflegt — er bestimmt, was er teilt.
model TenantProfile {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Selbstvorstellung (Freitext, optional — der Mieter darf hier
  // selbst entscheiden, was er sagt; AGG schützt vor erzwungenen
  // sensiblen Angaben)
  aboutText  String?

  // Wirtschaftliche Eckdaten
  employmentType     String?   // "Festanstellung", "Selbstständig", "Beamter"
  employmentDuration String?   // z.B. "seit 3 Jahren"
  employer           String?   // optional
  monthlyNetIncome   Int?      // EUR
  additionalIncome   Int?      // EUR (z.B. Kapitaleinkünfte, Unterhalt)
  schufaScore        String?   // Freitext "Score 95" / "saubere Auskunft"
  hasSchufaCert      Boolean   @default(false) // Selbstauskunft liegt vor

  // Haushalt — bewusst neutral
  householdSize Int?   // Anzahl Personen, ohne Familienstand-Bezug
  hasPets       Boolean @default(false)
  petDetails    String?
  smoker        Boolean @default(false)

  // Wunschkriterien
  desiredCity        String?   // z.B. "Berlin"
  desiredAreaMin     Float?    // m²
  desiredRoomsMin    Float?    // Zimmer
  desiredRentMax     Int?      // EUR Kaltmiete max
  desiredMoveInDate  DateTime?
  intendedDuration   String?   // "langfristig", "1-2 Jahre"
  openForFurnished   Boolean   @default(false)
  needsBarrierFree   Boolean   @default(false)
  needsParking       Boolean   @default(false)

  visibility ProfileVisibility @default(PRIVATE)
}

// Phase L11.3 — Makler-Vermittlungs-Lead.
// Wenn der KI-Verkaufsberater einem Eigentuemer den Makler-Pfad
// empfiehlt, kann er ueber eine Lead-Form Adresse + Kontakt
// hinterlassen. Marco (selber Makler) bedient die Leads im
// Admin-Bereich.
//
// Bewusst ohne FK auf User: Lead darf anonym (ohne Sign-up)
// erfasst werden — der Eigentuemer soll keine Huerde haben.
enum BrokerLeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  CLOSED_WON
  CLOSED_LOST
}

model BrokerLead {
  id        String           @id @default(cuid())
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  status    BrokerLeadStatus @default(NEW)

  // Kontakt
  firstName String
  lastName  String
  email     String
  phone     String

  // Immobilie (Adresse — Lead-Form Pflichtfelder)
  street     String
  postalCode String
  city       String

  // Wizard-Eckdaten — Snapshot, damit Marco die Anfrage bewerten kann
  assetType        String  // "ETW" | "EFH" | "MFH" | "GEWERBE" | "GRUNDSTUECK"
  locationQuality  String  // "TOP" | "GUT" | "MITTEL" | "SCHWACH"
  area             Float
  yearBuilt        Int
  condition        String
  occupancy        String
  saleReason       String
  timePressure     String
  experience       String
  estimatedValue   Int?

  // Heuristik-Snapshot
  scoreSelbst      Int
  scoreMakler      Int

  // Optional: User-Notiz und KI-Refinement-Bericht (falls gepullt)
  ownerNote        String?
  aiReportSummary  String?

  // Marco-interne Notizen (nur Admin sichtbar)
  internalNote     String?

  @@index([status, createdAt])
  @@index([city])
}

// Verkäufer-Listing — Marketplace-Inserat (separat von Property = Investor-Watchlist).
model Listing {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  ownerId   String
  owner     User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  title       String
  description String        // Markdown / einfacher Fließtext
  propertyType AssetType
  status      ListingStatus @default(DRAFT)

  // Finanzdaten
  askingPrice Int           // EUR
  totalArea   Float         // m²
  totalRent   Int?          // monatliche Gesamt-Soll-Miete (EUR), optional bei DRAFT/Gewerbe-Leerstand

  // Lage + Anonymisierung
  city               String              // immer gefüllt, z. B. "Berlin"
  postalCode         String?             // optional, z. B. "10115"
  district           String?             // z. B. "Mitte"
  fullAddress        String?             // Straße + Hausnummer, nur intern
  anonymizationLevel AnonymizationLevel  @default(DISTRICT_ONLY)

  // --- Bausubstanz / Eckdaten (Listing v2) -----------------------
  yearBuilt        Int?                // Baujahr
  lastRenovation   Int?                // Jahr der letzten Sanierung
  condition        BuildingCondition?  // Zustand
  livingArea       Float?              // Wohnfläche m² (Wohnnutzung)
  commercialArea   Float?              // Gewerbefläche m²
  landArea         Float?              // Grundstücksfläche m²
  floors           Int?                // Anzahl Etagen

  // --- Einheiten (zentral für MFH/Gewerbe) -----------------------
  residentialUnits Int?                // Anzahl Wohneinheiten
  commercialUnits  Int?                // Anzahl Gewerbeeinheiten

  // --- Energie ---------------------------------------------------
  energyClass        EnergyClass?
  energyConsumption  Float?            // kWh/m²a (Endenergie)
  energyCarrier      EnergyCarrier?
  heatingType        String?           // "Etagenheizung", "Zentralheizung", ...

  // --- Vermietung (USP gegen Privatkäufer-Portale) ---------------
  actualRent           Int?            // Istmiete monatlich (EUR)
  vacancyRate          Float?          // Leerstand 0..1
  waltMonths           Float?          // gewichtete Restmietdauer (Monate)
  rentIndexed          Boolean?        // Indexmiete vorhanden
  rentEscalation       Boolean?        // Staffelmiete
  rentUpsidePotential  Int?            // EUR/Mon. zusätzlich erreichbar (vs. Mietspiegel)

  // --- Bausubstanz / Modernisierung (USP) ------------------------
  modernizationBacklog Int?            // Modernisierungsstau in EUR
  gegCompliant         Boolean?        // GEG-konform (oder Sanierung erforderlich)

  // --- Provision / Käufer-Nebenkosten ----------------------------
  commissionRate     Float?            // Käuferprovision in % (z. B. 3.57)
  commissionFree     Boolean?          // true => provisionsfrei
  buyerCommission    Float?            // alternativ: Provision absolut

  // --- Verfügbarkeit ---------------------------------------------
  availableFrom      DateTime?

  // --- Tag-Listen ------------------------------------------------
  features           String[]   @default([])  // "Aufzug","Keller","Stellplatz",...
  highlights         String[]   @default([])  // "Vollvermietet","Off-Market",...

  // --- Tenant-Mix (Gewerbe / Mischnutzung) -----------------------
  tenantCount        Int?              // Anzahl bestehender Mietverträge
  anchorTenant       String?           // Hauptmieter (z. B. "REWE", "DHL")
  tenantSectors      String[]   @default([])  // ["Einzelhandel","Gastronomie",...]

  // --- Premium-Listing (Phase G4) -------------------------------
  // Wenn featuredUntil > now: Inserat wird im Marketplace oben sortiert
  // und bekommt eine Premium-Pill. Wird durch Stripe-Checkout (one-off
  // 99 EUR) auf now + 30 Tage gesetzt.
  featuredUntil DateTime?

  images           ListingImage[]
  inquiries        Inquiry[]
  saleProcesses    SaleProcess[]
  buyerAccesses    BuyerDocAccess[]
  marketAnalysis   MarketAnalysis?
  offerEvaluations OfferEvaluation[]

  @@index([ownerId])
  @@index([status])
  @@index([propertyType])
  @@index([city])
}

// Bilder zu Listings — URLs zeigen auf Vercel Blob (oder externes Storage).
model ListingImage {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  listingId String
  listing   Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)

  url       String   // direkte HTTPS-URL aus dem Storage
  alt       String?  // Beschreibung für Screenreader / Lightbox
  sortOrder Int      @default(0)

  @@index([listingId, sortOrder])
}

// Anfrage eines Investors auf ein Verkäufer-Listing.
// Bei ACCEPTED bekommt der Investor die fullAddress des Listings freigegeben,
// und der Verkäufer sieht das Investor-Profil (auch wenn es PRIVATE ist —
// die Inquiry-Aktion gilt als Einwilligung des Investors).
model Inquiry {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  listingId  String
  listing    Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  investorId String
  investor   User    @relation("InvestorInquiries", fields: [investorId], references: [id], onDelete: Cascade)

  status     InquiryStatus @default(PENDING)
  message    String        // freier Text vom Investor

  response    String?      // optionale Antwort vom Verkäufer beim accept/reject
  respondedAt DateTime?    // Zeitpunkt des accept/reject

  ratings          Rating[]
  saleProcess      SaleProcess?
  offerEvaluations OfferEvaluation[]
  buyerAccesses    BuyerDocAccess[]

  // Doppelte PENDING-Inquiries vom selben Investor werden im Backend verhindert,
  // nicht via DB-Constraint — sonst könnte er nach REJECTED nicht erneut anfragen.
  @@index([listingId, status])
  @@index([investorId])
}

// Bewertung nach abgeschlossenem Deal — Phase E.
// Rechtlich: nur Tatsachenbehauptungen, Recht auf Gegendarstellung (rebuttal),
// erlaubt nur wenn Listing.status == SOLD und Inquiry.status == ACCEPTED.
// Pro Inquiry und pro Richtung (Investor→Verkäufer oder umgekehrt) max. eine Bewertung.
model Rating {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  inquiryId  String
  inquiry    Inquiry @relation(fields: [inquiryId], references: [id], onDelete: Cascade)

  fromUserId String
  fromUser   User    @relation("RatingsGiven", fields: [fromUserId], references: [id], onDelete: Cascade)

  toUserId   String
  toUser     User    @relation("RatingsReceived", fields: [toUserId], references: [id], onDelete: Cascade)

  direction  RatingDirection
  stars      Int      // 1..5 (im Backend per Zod erzwungen)
  body       String   // freier Text — Tatsachenbehauptungen erwartet

  rebuttal     String?    // Gegendarstellung der bewerteten Person
  rebuttalAt   DateTime?  // Zeitpunkt der Gegendarstellung

  @@unique([inquiryId, direction], name: "uniq_rating_per_direction")
  @@index([toUserId])
  @@index([fromUserId])
}

// Phase J1 — Verkaufsabwicklung.
// Pro Listing kann es mehrere SaleProcesses geben (einer aktiv,
// alte abgebrochen). currentStage steuert den Fortschritt;
// jeder Wechsel wird in SaleStageEntry geloggt (Audit-Timeline).
// inquiryId ist optional — Verkäufer kann auch ohne Marketplace-Anfrage
// einen externen Verkauf abwickeln (Off-Market-Deal).
model SaleProcess {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  listingId String
  listing   Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)

  inquiryId String?  @unique
  inquiry   Inquiry? @relation(fields: [inquiryId], references: [id], onDelete: SetNull)

  sellerId  String
  seller    User     @relation("SellerProcesses", fields: [sellerId], references: [id], onDelete: Cascade)

  buyerId   String?
  buyer     User?    @relation("BuyerProcesses", fields: [buyerId], references: [id], onDelete: SetNull)

  currentStage   SaleStage @default(ANFRAGE_AKZEPTIERT)
  stageEnteredAt DateTime  @default(now())

  notes              String?
  targetClosingDate  DateTime?
  agreedPrice        Int?     // EUR — kann von Listing.askingPrice abweichen

  documents SaleDocument[]
  stageLog  SaleStageEntry[]

  @@index([sellerId, currentStage])
  @@index([listingId, currentStage])
  @@index([buyerId])
}

// Audit-Log: jede Stage-Aenderung wird hier festgehalten.
// Damit kann der Verkäufer eine Timeline anzeigen.
model SaleStageEntry {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  processId String
  process   SaleProcess @relation(fields: [processId], references: [id], onDelete: Cascade)

  stage     SaleStage
  note      String?

  byUserId  String?
  by        User?    @relation("StageBy", fields: [byUserId], references: [id], onDelete: SetNull)

  @@index([processId, createdAt])
}

// Hochgeladene Dokumente zu einem SaleProcess. Pro (process, kind)
// genau eine Datei — Re-Upload überschreibt im Backend-Code.
model SaleDocument {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  processId String
  process   SaleProcess @relation(fields: [processId], references: [id], onDelete: Cascade)

  kind      SaleDocKind
  url       String       // Vercel-Blob-URL
  filename  String       // Original-Dateiname
  sizeBytes Int

  uploaderUserId String?
  uploader       User?  @relation("DocUploads", fields: [uploaderUserId], references: [id], onDelete: SetNull)

  @@unique([processId, kind])
  @@index([processId])
}

// Phase M1 — Token-basierte Dokumenten-Freigabe an einen Kaufinteressenten.
// Verkaeufer erzeugt pro Interessent einen Link, waehlt freigegebene
// Dokumenten-Kategorien (SaleDocKind[]) und teilt den Link per Mail / WhatsApp.
// Kaeufer oeffnet den Link OHNE Account und sieht nur die freigegebenen
// Dokumente. Anonymisierung des Listings respektiert anonymizationLevel.
//
// Bewusst am Listing aufgehaengt (nicht am SaleProcess), damit Pre-Sale-
// Freigaben (vor Besichtigung / Kaufpreis-Angebot) ohne aktiven SaleProcess
// funktionieren. Dokumente werden ueber den SaleProcess des gleichen
// Listings serviert; existiert kein Process, ist die Liste leer.
model BuyerDocAccess {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  listingId String
  listing   Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)

  sellerId  String
  seller    User     @relation("BuyerAccessSeller", fields: [sellerId], references: [id], onDelete: Cascade)

  // Optional: bereits zugeordneter Marketplace-Interessent / Kaeufer.
  inquiryId   String?
  inquiry     Inquiry? @relation(fields: [inquiryId], references: [id], onDelete: SetNull)
  buyerUserId String?
  buyerUser   User?    @relation("BuyerAccessBuyer", fields: [buyerUserId], references: [id], onDelete: SetNull)

  // Freitext-Label fuer die Verkaeufer-Uebersicht ("Familie Mueller, Termin 25.05.").
  buyerLabel String?
  buyerEmail String?
  notes      String?

  // 256 bit hex (64 Zeichen) zufaellig. Unique.
  token       String   @unique

  // Welche Dokumenten-Kategorien sind freigegeben?
  allowedDocKinds SaleDocKind[]

  // Ablauf / Revoke
  expiresAt DateTime?
  revokedAt DateTime?

  // Audit
  lastAccessedAt DateTime?
  accessCount    Int       @default(0)

  @@index([listingId, sellerId])
  @@index([sellerId, revokedAt])
}

// Phase M3 — In-App-Notification fuer den Verkaeufer.
// payloadJson speichert event-spezifische Daten (z.B. buyerLabel,
// accessId, listingTitle) als unstrukturiertes JSON.
// link ist optional und zeigt auf die Stelle in der App, wo der
// User mehr Kontext findet.
model UserNotification {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  kind      UserNotificationKind
  title     String
  body      String?
  link      String?
  payloadJson Json?

  readAt    DateTime?

  @@index([userId, readAt, createdAt])
  @@index([userId, kind])
}

// Phase K — KI-Marktanalyse (TEIL 1 des Prompts).
// Pro Listing genau ein Eintrag (1:1) — neue Analyse ueberschreibt
// die alte. rawJson speichert die vollstaendige Claude-Antwort
// fuer Audit/Debug; die Felder darueber sind extrahierte Aggregat-
// werte fuer schnelle UI-Anzeige.
model MarketAnalysis {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  listingId String   @unique
  listing   Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)

  // Marktpreis-Spanne (EUR)
  priceConservative Int?
  priceFair         Int?
  pricePremium      Int?

  salesSpeed     SaleSpeed?
  demand         DemandLevel?

  // Käufer-Zielgruppen als freie String-Liste, weil Claude beliebig
  // viele zurueckgibt (z. B. "Familien", "Senioren", "Single-Haushalte",
  // "Kapitalanleger", "Eigennutzer").
  buyerSegments  String[]   @default([])

  recommendedAskingPrice Int?
  negotiationRange       String?    // z. B. "Spielraum ca. 5–8 % nach unten"
  marketingStrategy      String?

  risks     String[] @default([])
  summary   String?  // 5-Satz-Zusammenfassung

  rawJson          Json
  model            String?
  promptTokens     Int?
  completionTokens Int?
}

// Phase L — Mietobjekt. Eigene Tabelle (nicht Erweiterung von Listing),
// weil Vermietung andere Datenstruktur und anderen Lebenszyklus hat
// (monatliche Miete, Kaution, viele Bewerber pro Wohnung).
model RentalUnit {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  ownerId   String
  owner     User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  title       String
  description String   @default("")

  city        String
  district    String?
  postalCode  String?
  fullAddress String?

  // Wohnungs-Eckdaten
  rooms       Float    // 1.0, 2.5, 3.0, …
  livingArea  Float    // m²
  floor       String?  // "EG", "3. OG", "DG"

  // Miete + Kaution (alle EUR)
  rentCold   Int       // Kaltmiete pro Monat
  utilities  Int?      // Nebenkosten/Betriebskosten pro Monat
  totalRent  Int?      // Warmmiete pro Monat (kann auch berechnet werden)
  deposit    Int?      // Kaution

  // Energie (Re-Use bestehender Enums)
  energyClass       EnergyClass?
  energyConsumption Float?
  energyCarrier     EnergyCarrier?
  heatingType       String?

  // Verfuegbarkeit
  status        RentalStatus @default(DRAFT)
  availableFrom DateTime?

  // Mietdauer
  fixedTerm        Boolean @default(false)
  fixedTermMonths  Int?

  // --- Phase L5: Erweiterte Inserat-Felder ----------------------

  // Bausubstanz
  yearBuilt        Int?
  lastRenovation   Int?
  totalUnits       Int?     // Wohneinheiten im Gebaeude

  // Raum-Detail
  bathrooms        Int?     // Anzahl Baeder
  separateGuestWc  Boolean  @default(false)

  // Aussenflaechen
  balcony          Boolean  @default(false)
  balconyArea      Float?   // m²
  terrace          Boolean  @default(false)
  terraceArea      Float?   // m²
  garden           Boolean  @default(false)
  gardenShared     Boolean  @default(false)  // Gemeinschaftsgarten
  cellar           Boolean  @default(false)
  attic            Boolean  @default(false)  // Dachboden / Speicher

  // Komfort / Barrierefreiheit
  elevator         Boolean  @default(false)
  barrierFree      Boolean  @default(false)
  furnished        Boolean  @default(false)  // voll moebliert
  partlyFurnished  Boolean  @default(false)  // teilmoebliert
  kitchenIncluded  Boolean  @default(false)  // Einbaukueche im Mietpreis
  kitchenBuyOut    Int?     // Ablöse Kueche EUR (optional)

  // Stellplatz
  parkingType      String?  // "GARAGE" / "STELLPLATZ" / "TIEFGARAGE" / "KEINER"
  parkingCost      Int?     // EUR/Monat zusaetzlich

  // Haustiere
  petsAllowed      Boolean? // null = nach Absprache, true = ja, false = nein
  petsNote         String?  // z. B. "Kleintiere ja, Hund auf Anfrage"

  // Internet
  internetAvailable Boolean? // null = unbekannt
  internetSpeed     String?  // "50 Mbit", "Glasfaser", "1 Gbit", ...

  // Mietbedingungen
  minRentDurationMonths Int?    // Mindestmietdauer (Monate)
  depositMonths         Float?  // Kaution in Kaltmieten (z. B. 3.0)
  conditions            String? // freie Bedingungen, z. B. "Nichtraucher"

  // Tags / Ausstattung (frei)
  features  String[] @default([])    // "Balkon","Aufzug","Einbaukueche", ...

  images       RentalUnitImage[]
  applications RentalApplication[]

  @@index([ownerId])
  @@index([status])
  @@index([city])
}

// Bilder zu Mietobjekten — wie ListingImage, aber separat
// damit Verkauf und Vermietung sauber getrennt bleiben.
model RentalUnitImage {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  unitId    String
  unit      RentalUnit @relation(fields: [unitId], references: [id], onDelete: Cascade)

  url       String
  alt       String?
  sortOrder Int      @default(0)

  @@index([unitId, sortOrder])
}

// Mietbewerbung. WICHTIG: keine sensiblen Merkmale erfassen
// (Ethnie, Religion, Geschlecht, etc.). Felder hier sind ausschliesslich
// organisatorisch/wirtschaftlich.
model RentalApplication {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  unitId    String
  unit      RentalUnit @relation(fields: [unitId], references: [id], onDelete: Cascade)

  // Wenn der Bewerber selbst eingeloggt war (Selbstbewerbung ueber
  // Mietboerse), verknuepfen wir ihn als User. Bei manuellem
  // Vermieter-Eintrag bleibt das Feld null.
  applicantUserId String?
  applicantUser   User?   @relation("RentalApplicationsSent", fields: [applicantUserId], references: [id], onDelete: SetNull)

  // Kontakt (Pflichtfeld: Name, sonst optional)
  applicantName String
  email         String?
  phone         String?

  // Wirtschaftliche Faktoren
  monthlyNetIncome   Int?     // Haushaltsnetto pro Monat (EUR)
  employmentType     String?  // "Festanstellung unbefristet", "Selbststaendig", "Beamter", ...
  employmentDuration String?  // "5 Jahre", "neu seit 3 Monaten"
  schufaScore        String?  // "100 %", "97 %", "kein SCHUFA verfuegbar"

  // Organisatorische Faktoren (NICHT diskriminierend, rein praktisch)
  householdSize Int?    // Personen im Haushalt (inkl. Bewerber)
  hasPets       Boolean @default(false)
  petDetails    String?
  smoker        Boolean @default(false)

  // Kontext
  desiredMoveInDate DateTime?
  intendedDuration  String?  // "langfristig", "2-3 Jahre", "befristet bis ..."

  // Notizen vom Vermieter (frei)
  notes String?

  status ApplicationStatus @default(NEW)

  evaluations ApplicantEvaluation[]

  @@index([unitId, status])
}

// KI-Bewertung einer Bewerbung (TEIL 1 + 2 + 3 + 4 + 5 des Marco-Prompts).
// Pro Application kann es mehrere Bewertungen geben (z. B. nach Update
// der Bewerber-Daten neu bewerten lassen) — History bleibt erhalten.
model ApplicantEvaluation {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  applicationId String
  application   RentalApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  // Output-Hauptfelder
  rating ApplicantRating

  summary       String
  strengths     String[] @default([])
  risks         String[] @default([])
  openQuestions String[] @default([])

  // Faktor-Bewertungen (jeweils kurzer Text)
  financialStability String?
  sizeFit            String?
  expectedDuration   String?
  reliability        String?
  communication      String?

  // Handlungsempfehlungen
  recommendViewing  Boolean @default(false)
  requestDocuments  String?
  suggestFollowUp   String?

  rationale String?

  rawJson Json
  model   String?

  @@index([applicationId, createdAt])
}

// Phase K — KI-Bewertung eines konkreten Kaeufer-Angebots (TEIL 2).
// Pro Listing kann es mehrere Bewertungen geben (verschiedene Angebote,
// History). Optional an Inquiry geknuepft, wenn das Angebot aus einer
// Marketplace-Anfrage stammt.
model OfferEvaluation {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  listingId String
  listing   Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)

  inquiryId String?
  inquiry   Inquiry? @relation(fields: [inquiryId], references: [id], onDelete: SetNull)

  offerAmount Int     // EUR (Angebot des Kaeufers)
  offerNote   String? // optional: was schreibt der Kaeufer dazu

  attractiveness     OfferAttractiveness?
  successProbability Float?              // 0..1
  recommendation     OfferRecommendation?

  counterOffer       Int?    // EUR — was Claude als Gegenangebot vorschlaegt
  negotiationHints   String?
  strategicAdvice    String?

  rawJson Json
  model   String?

  @@index([listingId, createdAt])
  @@index([inquiryId])
}

model Property {
  id        String     @id @default(cuid())
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  title     String
  price     Int
  rent      Int
  location  String
  size      Float

  // Phase O+ — erweiterte Objektdaten (Capital Layer / Finanzierungsmappe)
  yearBuilt   Int?
  condition   BuildingCondition?
  energyClass EnergyClass?
  units       Int?

  status    DealStatus @default(WATCHING)
  dealType  DealType   @default(FREE_SALE)

  ownerId   String?
  owner     User?      @relation(fields: [ownerId], references: [id], onDelete: SetNull)

  analyses           Analysis[]
  offer              Offer?
  notes              Note[]
  marketComparison   MarketComparison?
  auction            AuctionInfo?
  financingRequests  FinancingRequest[]

  @@index([ownerId])
}

model Analysis {
  id           String   @id @default(cuid())
  createdAt    DateTime @default(now())

  propertyId   String
  property     Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  scenarioName String   @default("Standard")

  equityRatio       Float @default(0.20)
  loanInterestRate  Float @default(0.038)
  loanRepaymentRate Float @default(0.02)
  taxRateIncome     Float @default(0.42)
  closingCostsRate  Float @default(0.10)
  maintenanceRate   Float @default(0.30)
  vacancyRate       Float @default(0.05)
  buildingShare     Float @default(0.80)
  afaRate           Float @default(0.02)

  closingCosts        Int   @default(0)
  totalInvestment     Int   @default(0)
  equity              Int   @default(0)
  loan                Int   @default(0)
  monthlyInterest     Float @default(0)
  monthlyRepayment    Float @default(0)
  monthlyAfA          Float @default(0)
  monthlyMaintenance  Float @default(0)
  monthlyVacancyLoss  Float @default(0)

  grossYield        Float @default(0)
  netYield          Float @default(0)
  cashflow          Float @default(0)
  cashflowAfterTax  Float @default(0)
  score             Int   @default(0)
}

model Offer {
  id              String   @id @default(cuid())
  createdAt       DateTime @default(now())

  propertyId      String   @unique
  property        Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  suggestedPrice  Int
  message         String
  model           String?
}

model Note {
  id          String   @id @default(cuid())
  createdAt   DateTime @default(now())

  propertyId  String
  property    Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  body        String
}

model MarketComparison {
  id          String       @id @default(cuid())
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  propertyId  String       @unique
  property    Property     @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  rentPerSqmLow    Float
  rentPerSqmHigh   Float
  pricePerSqmLow   Float
  pricePerSqmHigh  Float
  rating           MarketRating
  rationale        String
  dataCaveat       String
  model            String?
}

model AuctionInfo {
  id              String       @id @default(cuid())
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  propertyId      String       @unique
  property        Property     @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  auctionType     AuctionType  @default(ZVG)
  caseNumber      String?      // Aktenzeichen, z. B. "5K 123/24"
  marketValue     Int?         // Verkehrswert lt. Gutachten in EUR
  auctionDate     DateTime?    // Versteigerungstermin
  auctionLocation String?      // Amtsgericht / Plattform
  sourceUrl       String?      // Link zur Bekanntmachung / zum Termin
  rawText         String?      // Original-Bekanntmachungstext (max ein paar KB) zum Nachschlagen

  bidLimit        Int?         // Berechnetes Bietlimit (max Kaufpreis bei CF n. Steuer ≥ 0)
  bidLimitNeutral Int?         // Bietlimit für CF n. Steuer = 0 (Break-Even)
  notes           String?      // Auffälligkeiten aus der Extraktion
}

// Phase O — Oikos Capital Layer: persistente Finanzierungsanfrage.
// Wird aus einem Objekt heraus angelegt und bleibt im Finanzierungs-Cockpit
// erhalten. Snapshot der Bankfähigkeit (overall + Score) zum Zeitpunkt des
// Anlegens — damit der Vorgang nachvollziehbar bleibt, auch wenn sich
// Profil/Analyse später ändern. Multi-Tenant via ownerId.
//
// Reine Aufbereitung/Organisation — KEINE Vermittlung (kein § 34i/§ 34c GewO).
model FinancingRequest {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  propertyId String
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  ownerId    String
  owner      User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  status FinancingRequestStatus @default(OFFEN)

  // Snapshot der Bankfähigkeits-Ampel beim Anlegen
  overall        String?  // "GREEN" | "YELLOW" | "RED" (Snapshot)
  readinessScore Int?     // 0..100 (Snapshot)

  // Optionale Eckdaten des Vorgangs
  desiredLoanAmount Int?    // gewünschtes Darlehensvolumen (EUR)
  note              String? // freie Notiz des Investors

  @@index([ownerId, status])
  @@index([propertyId])
}

// Phase P — Oikos Capital Layer: Finanzierungspartner (Verzeichnis).
// Neutrales, kriterienbasiertes Matching (Tippgeber) — KEINE Vermittlung
// durch Oikos. Mandatskriterien steuern, zu welchen Deals ein Partner passt.
// Admin-gepflegt. Leere Listen/null = keine Einschränkung.
model FinancingPartner {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  name   String
  type   FinancingPartnerType
  active Boolean              @default(true)

  // Mandatskriterien
  assetTypes    AssetType[] @default([])
  regions       String[]    @default([])  // Bundesländer/Städte; leer = überall
  minVolume     Int?                        // min. Darlehensvolumen (EUR)
  maxVolume     Int?                        // max. Darlehensvolumen (EUR)
  maxLtv        Float?                      // max. Beleihungsauslauf (0..1)
  investorTypes String[]    @default([])    // "PRIVAT","HOLDING","SEMI_PRO","FAMILY_OFFICE"; leer = alle

  // Kontakt (für spätere Lead-Übergabe; reine Kontaktdaten)
  contactEmail String?
  contactPhone String?
  website      String?
  note         String?

  @@index([active, type])
}

// =====================================================================
// Phase F — Offmarket-Layer (additiver Zusatz zum bestehenden Portal)
//
// Konzept: Offmarket-Leads sind diskrete Verkaufsabsichten, die NICHT
// auf dem oeffentlichen Marketplace erscheinen. Der Eigentuemer waehlt
// gezielt verifizierte Investoren aus und laedt sie ein. Erst nach
// Einladungs-Annahme (ACCEPTED) wird Klar-Lage / Kontakt freigegeben
// und ein 1:1-Chat (OffmarketMessage) freigeschaltet.
//
// Das ist parallel zum bestehenden Listing/Marketplace-/Inquiry-Flow:
// nichts an Listing/Inquiry/Rating/SaleProcess wurde veraendert.
// =====================================================================

enum OffmarketLeadStatus {
  DRAFT       // nur Owner sichtbar
  ACTIVE      // Owner laedt aktiv Investoren ein
  PAUSED      // Owner hat pausiert, neue Einladungen blockiert
  CLOSED      // Off-Market-Deal abgeschlossen oder Owner zieht zurueck
}

enum OffmarketInviteStatus {
  PENDING     // Owner hat Investor eingeladen, Antwort offen
  ACCEPTED    // Investor hat Interesse bekundet -> Kontakt/Adresse frei
  DECLINED    // Investor hat abgelehnt
  WITHDRAWN   // Owner hat Einladung zurueckgezogen
  EXPIRED     // ueber 30 Tage ohne Antwort
}

// Anonymisierungs-Level wie bei Listing — wir wiederverwenden den Enum.
// (AnonymizationLevel ist bereits in diesem Schema definiert.)

model OffmarketLead {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  ownerId   String
  owner     User     @relation("OffmarketLeadOwner", fields: [ownerId], references: [id], onDelete: Cascade)

  // Pflicht-Eckdaten (bewusst schlank gegenueber Listing v2)
  title              String              // interner Titel, dem Investor wird die ANON-Variante gezeigt
  propertyType       AssetType
  city               String
  postalCode         String?
  district           String?
  fullAddress        String?             // erst nach Invite-ACCEPTED sichtbar
  anonymizationLevel AnonymizationLevel  @default(CITY_ONLY)

  approxArea         Float               // ungefaehre Gesamtflaeche m²
  approxPrice        Int                 // Wunschpreis (EUR) — Range-Anzeige im UI
  approxRent         Int?                // Ist-Miete (EUR/Monat), optional

  // Freitext-Beschreibung fuer Investor (anonymisiert formuliert)
  description        String

  // Highlights fuer Match-Anzeige ("Vollvermietet","Erbe","Off-Market","Diskret")
  highlights         String[]            @default([])

  status             OffmarketLeadStatus @default(DRAFT)

  invites            OffmarketInvite[]
  images             OffmarketLeadImage[]

  @@index([ownerId])
  @@index([status])
  @@index([city, propertyType])
}

model OffmarketInvite {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  leadId       String
  lead         OffmarketLead @relation(fields: [leadId], references: [id], onDelete: Cascade)

  // Owner = wer einlaedt (denormalisiert fuer schnellen Owner-Filter)
  ownerId      String
  owner        User          @relation("OffmarketInvitesSentByOwner", fields: [ownerId], references: [id], onDelete: Cascade)

  // Investor = wer eingeladen wird
  investorId   String
  investor     User          @relation("OffmarketInvitesReceivedByInvestor", fields: [investorId], references: [id], onDelete: Cascade)

  status       OffmarketInviteStatus @default(PENDING)

  // Optionale persoenliche Notiz des Owners an den Investor
  ownerNote    String?
  // Antworttext des Investors bei ACCEPT/DECLINE
  investorNote String?

  respondedAt  DateTime?

  messages     OffmarketMessage[]

  // Pro (Lead, Investor) genau eine Einladung — verhindert Doppel-Einladungen.
  @@unique([leadId, investorId], name: "uniq_offmarket_invite")
  @@index([investorId, status])
  @@index([ownerId, status])
}

model OffmarketMessage {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  inviteId  String
  invite    OffmarketInvite @relation(fields: [inviteId], references: [id], onDelete: Cascade)

  senderId  String
  sender    User     @relation("OffmarketMessageSender", fields: [senderId], references: [id], onDelete: Cascade)

  body      String

  // Soft-Read-Receipt fuer den jeweils anderen Teilnehmer
  readAt    DateTime?

  @@index([inviteId, createdAt])
}

// =====================================================================
// Phase F.2 — Offmarket-Bilder mit 3 Anzeige-Stufen
// =====================================================================
// Pro Lead beliebig viele Bilder. Drei URLs pro Bild:
//   - originalUrl   = Originalbild (nur Owner + Investor nach ACCEPTED)
//   - blurredUrl    = stark verpixelte/blurr-Version (sharp, public)
//   - stylizedUrl?  = optional KI-stilisiertes Aquarell/Skizze (premium)
//
// Im Frontend wird je nach Sicht das passendste Bild gerendert:
//   - Owner-Edit:        original (zum Pruefen)
//   - PENDING-Invite:    stylized > blurred (anonyme Sicht)
//   - ACCEPTED-Invite:   original (Kontakt freigegeben)
//   - Public Akquise:    blurred (Demo-Aesthetik)
// =====================================================================

model OffmarketLeadImage {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  leadId    String
  lead      OffmarketLead @relation(fields: [leadId], references: [id], onDelete: Cascade)

  originalUrl  String   // Vercel-Blob-URL des Originals
  blurredUrl   String?  // sharp-erzeugte Blur-Version (auto bei Upload)
  stylizedUrl  String?  // KI-erzeugte Stilisierung (manuell, optional)

  alt          String?  // Beschreibung (auto-generiert oder manuell)
  sortOrder    Int      @default(0)

  // Caption / Lichtstimmung-Hinweis fuer Investoren-Sicht (von Claude
  // optional generiert)
  caption      String?

  @@index([leadId, sortOrder])
}
