generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum DealStatus {
  WATCHING
  INQUIRED
  NEGOTIATING
  LOI
  NOTAR
  CLOSED
  REJECTED
}

enum DealType {
  FREE_SALE
  AUCTION
}

enum AuctionType {
  ZVG
  DGA
  SDL
  KARHAUSEN
  OTHER
}

enum MarketRating {
  below_market
  fair
  above_market
}

enum UserRole {
  INVESTOR
  SELLER
  BOTH
}

enum AssetType {
  MFH
  COMMERCIAL
  MIXED_USE
  SINGLE_FAMILY
  APARTMENT
  LAND
  OTHER
}

enum ProfileVisibility {
  PRIVATE
  ON_REQUEST
  PUBLIC
}

enum TrackrecordRole {
  BUYER
  SELLER
  PARTNER
  BROKER
  OTHER
}

enum ListingStatus {
  DRAFT
  ACTIVE
  IN_NEGOTIATION
  SOLD
  ARCHIVED
}

enum AnonymizationLevel {
  FULL_ADDRESS
  DISTRICT_ONLY
  CITY_ONLY
}

// Zustand der Bausubstanz — relevant für Modernisierungs-Einschätzung.
enum BuildingCondition {
  NEW                // Erstbezug nach Sanierung / Neubau
  REFURBISHED        // Kernsaniert
  MODERNIZED         // Modernisiert (Heizung, Fenster, Bäder)
  MAINTAINED         // Gepflegt, ohne grossen Stau
  NEEDS_RENOVATION   // Sanierungsbedürftig
}

// Energieausweis-Klasse (GEG/EnEV-konforme Skala).
// "A_PLUS" weil "+" in Prisma-Enums nicht erlaubt ist.
enum EnergyClass {
  A_PLUS
  A
  B
  C
  D
  E
  F
  G
  H
}

// Primärer Energieträger der Heizung.
enum EnergyCarrier {
  GAS
  OIL
  ELECTRIC
  DISTRICT_HEATING   // Fernwärme
  HEAT_PUMP          // Wärmepumpe
  PELLETS
  WOOD
  SOLAR
  OTHER
}

enum InquiryStatus {
  PENDING
  ACCEPTED
  REJECTED
  WITHDRAWN
}

enum RatingDirection {
  INVESTOR_TO_SELLER
  SELLER_TO_INVESTOR
}

// Subscription-Plan eines Users (Stripe-gestützt).
enum UserPlan {
  FREE
  INVESTOR_PRO
  SELLER_PRO
}

model User {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  clerkId   String   @unique
  email     String
  name      String?
  role      UserRole @default(INVESTOR)

  onboardingCompletedAt DateTime?

  // --- Subscription / Stripe (Phase G1) ---
  plan                 UserPlan  @default(FREE)
  planValidUntil       DateTime? // Ende der bezahlten Periode; null = nie aktiv gewesen
  stripeCustomerId     String?   @unique
  stripeSubscriptionId String?   @unique

  properties        Property[]
  investorProfile   InvestorProfile?
  trackrecordItems  TrackrecordItem[]
  listings          Listing[]
  inquiriesSent     Inquiry[] @relation("InvestorInquiries")
  ratingsGiven      Rating[]  @relation("RatingsGiven")
  ratingsReceived   Rating[]  @relation("RatingsReceived")
}

model InvestorProfile {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Selbstdarstellung
  bio                       String?
  investmentExperienceYears Int      @default(0)

  // Bonität (alle in EUR; nullable, weil User es schrittweise füllt)
  equity        Int?
  monthlyIncome Int?
  monthlyDebt   Int?

  // Finanzierungs-Status
  financingPreApproved Boolean @default(false)
  financingNote        String? // z. B. "Bankzusage Sparkasse Berlin, gültig bis Q4/2026"

  // Präferenzen — als String[] gespeichert für Flexibilität
  preferredAssetTypes AssetType[] @default([])
  preferredRegions    String[]    @default([]) // z. B. ["Berlin", "10115", "NRW"]
  minTicketSize       Int?        // EUR — Untergrenze interessanter Deals
  maxTicketSize       Int?        // EUR — Obergrenze (max Investment)

  visibility ProfileVisibility @default(PRIVATE)
}

model TrackrecordItem {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  type        AssetType
  year        Int             // Jahr des Deals
  value       Int?            // Kaufpreis bzw. Volumen in EUR (optional, kann anonym bleiben)
  location    String          // z. B. "Berlin, Charlottenburg" oder "NRW"
  role        TrackrecordRole
  description String?         // 1–3 Sätze Kontext
  verifiedBy  String?         // optionale Verifikation, z. B. Notar-Aktenzeichen

  @@index([userId, year])
}

// Verkäufer-Listing — Marketplace-Inserat (separat von Property = Investor-Watchlist).
model Listing {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  ownerId   String
  owner     User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  title       String
  description String        // Markdown / einfacher Fließtext
  propertyType AssetType
  status      ListingStatus @default(DRAFT)

  // Finanzdaten
  askingPrice Int           // EUR
  totalArea   Float         // m²
  totalRent   Int?          // monatliche Gesamt-Soll-Miete (EUR), optional bei DRAFT/Gewerbe-Leerstand

  // Lage + Anonymisierung
  city               String              // immer gefüllt, z. B. "Berlin"
  postalCode         String?             // optional, z. B. "10115"
  district           String?             // z. B. "Mitte"
  fullAddress        String?             // Straße + Hausnummer, nur intern
  anonymizationLevel AnonymizationLevel  @default(DISTRICT_ONLY)

  // --- Bausubstanz / Eckdaten (Listing v2) -----------------------
  yearBuilt        Int?                // Baujahr
  lastRenovation   Int?                // Jahr der letzten Sanierung
  condition        BuildingCondition?  // Zustand
  livingArea       Float?              // Wohnfläche m² (Wohnnutzung)
  commercialArea   Float?              // Gewerbefläche m²
  landArea         Float?              // Grundstücksfläche m²
  floors           Int?                // Anzahl Etagen

  // --- Einheiten (zentral für MFH/Gewerbe) -----------------------
  residentialUnits Int?                // Anzahl Wohneinheiten
  commercialUnits  Int?                // Anzahl Gewerbeeinheiten

  // --- Energie ---------------------------------------------------
  energyClass        EnergyClass?
  energyConsumption  Float?            // kWh/m²a (Endenergie)
  energyCarrier      EnergyCarrier?
  heatingType        String?           // "Etagenheizung", "Zentralheizung", ...

  // --- Vermietung (USP gegen Privatkäufer-Portale) ---------------
  actualRent           Int?            // Istmiete monatlich (EUR)
  vacancyRate          Float?          // Leerstand 0..1
  waltMonths           Float?          // gewichtete Restmietdauer (Monate)
  rentIndexed          Boolean?        // Indexmiete vorhanden
  rentEscalation       Boolean?        // Staffelmiete
  rentUpsidePotential  Int?            // EUR/Mon. zusätzlich erreichbar (vs. Mietspiegel)

  // --- Bausubstanz / Modernisierung (USP) ------------------------
  modernizationBacklog Int?            // Modernisierungsstau in EUR
  gegCompliant         Boolean?        // GEG-konform (oder Sanierung erforderlich)

  // --- Provision / Käufer-Nebenkosten ----------------------------
  commissionRate     Float?            // Käuferprovision in % (z. B. 3.57)
  commissionFree     Boolean?          // true => provisionsfrei
  buyerCommission    Float?            // alternativ: Provision absolut

  // --- Verfügbarkeit ---------------------------------------------
  availableFrom      DateTime?

  // --- Tag-Listen ------------------------------------------------
  features           String[]   @default([])  // "Aufzug","Keller","Stellplatz",...
  highlights         String[]   @default([])  // "Vollvermietet","Off-Market",...

  // --- Tenant-Mix (Gewerbe / Mischnutzung) -----------------------
  tenantCount        Int?              // Anzahl bestehender Mietverträge
  anchorTenant       String?           // Hauptmieter (z. B. "REWE", "DHL")
  tenantSectors      String[]   @default([])  // ["Einzelhandel","Gastronomie",...]

  // --- Premium-Listing (Phase G4) -------------------------------
  // Wenn featuredUntil > now: Inserat wird im Marketplace oben sortiert
  // und bekommt eine Premium-Pill. Wird durch Stripe-Checkout (one-off
  // 99 EUR) auf now + 30 Tage gesetzt.
  featuredUntil DateTime?

  images    ListingImage[]
  inquiries Inquiry[]

  @@index([ownerId])
  @@index([status])
  @@index([propertyType])
  @@index([city])
}

// Bilder zu Listings — URLs zeigen auf Vercel Blob (oder externes Storage).
model ListingImage {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  listingId String
  listing   Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)

  url       String   // direkte HTTPS-URL aus dem Storage
  alt       String?  // Beschreibung für Screenreader / Lightbox
  sortOrder Int      @default(0)

  @@index([listingId, sortOrder])
}

// Anfrage eines Investors auf ein Verkäufer-Listing.
// Bei ACCEPTED bekommt der Investor die fullAddress des Listings freigegeben,
// und der Verkäufer sieht das Investor-Profil (auch wenn es PRIVATE ist —
// die Inquiry-Aktion gilt als Einwilligung des Investors).
model Inquiry {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  listingId  String
  listing    Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  investorId String
  investor   User    @relation("InvestorInquiries", fields: [investorId], references: [id], onDelete: Cascade)

  status     InquiryStatus @default(PENDING)
  message    String        // freier Text vom Investor

  response    String?      // optionale Antwort vom Verkäufer beim accept/reject
  respondedAt DateTime?    // Zeitpunkt des accept/reject

  ratings     Rating[]

  // Doppelte PENDING-Inquiries vom selben Investor werden im Backend verhindert,
  // nicht via DB-Constraint — sonst könnte er nach REJECTED nicht erneut anfragen.
  @@index([listingId, status])
  @@index([investorId])
}

// Bewertung nach abgeschlossenem Deal — Phase E.
// Rechtlich: nur Tatsachenbehauptungen, Recht auf Gegendarstellung (rebuttal),
// erlaubt nur wenn Listing.status == SOLD und Inquiry.status == ACCEPTED.
// Pro Inquiry und pro Richtung (Investor→Verkäufer oder umgekehrt) max. eine Bewertung.
model Rating {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  inquiryId  String
  inquiry    Inquiry @relation(fields: [inquiryId], references: [id], onDelete: Cascade)

  fromUserId String
  fromUser   User    @relation("RatingsGiven", fields: [fromUserId], references: [id], onDelete: Cascade)

  toUserId   String
  toUser     User    @relation("RatingsReceived", fields: [toUserId], references: [id], onDelete: Cascade)

  direction  RatingDirection
  stars      Int      // 1..5 (im Backend per Zod erzwungen)
  body       String   // freier Text — Tatsachenbehauptungen erwartet

  rebuttal     String?    // Gegendarstellung der bewerteten Person
  rebuttalAt   DateTime?  // Zeitpunkt der Gegendarstellung

  @@unique([inquiryId, direction], name: "uniq_rating_per_direction")
  @@index([toUserId])
  @@index([fromUserId])
}

model Property {
  id        String     @id @default(cuid())
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  title     String
  price     Int
  rent      Int
  location  String
  size      Float

  status    DealStatus @default(WATCHING)
  dealType  DealType   @default(FREE_SALE)

  ownerId   String?
  owner     User?      @relation(fields: [ownerId], references: [id], onDelete: SetNull)

  analyses           Analysis[]
  offer              Offer?
  notes              Note[]
  marketComparison   MarketComparison?
  auction            AuctionInfo?

  @@index([ownerId])
}

model Analysis {
  id           String   @id @default(cuid())
  createdAt    DateTime @default(now())

  propertyId   String
  property     Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  scenarioName String   @default("Standard")

  equityRatio       Float @default(0.20)
  loanInterestRate  Float @default(0.038)
  loanRepaymentRate Float @default(0.02)
  taxRateIncome     Float @default(0.42)
  closingCostsRate  Float @default(0.10)
  maintenanceRate   Float @default(0.30)
  vacancyRate       Float @default(0.05)
  buildingShare     Float @default(0.80)
  afaRate           Float @default(0.02)

  closingCosts        Int   @default(0)
  totalInvestment     Int   @default(0)
  equity              Int   @default(0)
  loan                Int   @default(0)
  monthlyInterest     Float @default(0)
  monthlyRepayment    Float @default(0)
  monthlyAfA          Float @default(0)
  monthlyMaintenance  Float @default(0)
  monthlyVacancyLoss  Float @default(0)

  grossYield        Float @default(0)
  netYield          Float @default(0)
  cashflow          Float @default(0)
  cashflowAfterTax  Float @default(0)
  score             Int   @default(0)
}

model Offer {
  id              String   @id @default(cuid())
  createdAt       DateTime @default(now())

  propertyId      String   @unique
  property        Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  suggestedPrice  Int
  message         String
  model           String?
}

model Note {
  id          String   @id @default(cuid())
  createdAt   DateTime @default(now())

  propertyId  String
  property    Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  body        String
}

model MarketComparison {
  id          String       @id @default(cuid())
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  propertyId  String       @unique
  property    Property     @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  rentPerSqmLow    Float
  rentPerSqmHigh   Float
  pricePerSqmLow   Float
  pricePerSqmHigh  Float
  rating           MarketRating
  rationale        String
  dataCaveat       String
  model            String?
}

model AuctionInfo {
  id              String       @id @default(cuid())
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  propertyId      String       @unique
  property        Property     @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  auctionType     AuctionType  @default(ZVG)
  caseNumber      String?      // Aktenzeichen, z. B. "5K 123/24"
  marketValue     Int?         // Verkehrswert lt. Gutachten in EUR
  auctionDate     DateTime?    // Versteigerungstermin
  auctionLocation String?      // Amtsgericht / Plattform
  sourceUrl       String?      // Link zur Bekanntmachung / zum Termin
  rawText         String?      // Original-Bekanntmachungstext (max ein paar KB) zum Nachschlagen

  bidLimit        Int?         // Berechnetes Bietlimit (max Kaufpreis bei CF n. Steuer ≥ 0)
  bidLimitNeutral Int?         // Bietlimit für CF n. Steuer = 0 (Break-Even)
  notes           String?      // Auffälligkeiten aus der Extraktion
}
