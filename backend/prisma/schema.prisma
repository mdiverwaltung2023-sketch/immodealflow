generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum DealStatus {
  WATCHING
  INQUIRED
  NEGOTIATING
  LOI
  NOTAR
  CLOSED
  REJECTED
}

enum DealType {
  FREE_SALE
  AUCTION
}

enum AuctionType {
  ZVG
  DGA
  SDL
  KARHAUSEN
  OTHER
}

enum MarketRating {
  below_market
  fair
  above_market
}

model Property {
  id        String     @id @default(cuid())
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  title     String
  price     Int
  rent      Int
  location  String
  size      Float

  status    DealStatus @default(WATCHING)
  dealType  DealType   @default(FREE_SALE)

  analyses           Analysis[]
  offer              Offer?
  notes              Note[]
  marketComparison   MarketComparison?
  auction            AuctionInfo?
}

model Analysis {
  id           String   @id @default(cuid())
  createdAt    DateTime @default(now())

  propertyId   String
  property     Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  scenarioName String   @default("Standard")

  equityRatio       Float @default(0.20)
  loanInterestRate  Float @default(0.038)
  loanRepaymentRate Float @default(0.02)
  taxRateIncome     Float @default(0.42)
  closingCostsRate  Float @default(0.10)
  maintenanceRate   Float @default(0.30)
  vacancyRate       Float @default(0.05)
  buildingShare     Float @default(0.80)
  afaRate           Float @default(0.02)

  closingCosts        Int   @default(0)
  totalInvestment     Int   @default(0)
  equity              Int   @default(0)
  loan                Int   @default(0)
  monthlyInterest     Float @default(0)
  monthlyRepayment    Float @default(0)
  monthlyAfA          Float @default(0)
  monthlyMaintenance  Float @default(0)
  monthlyVacancyLoss  Float @default(0)

  grossYield        Float @default(0)
  netYield          Float @default(0)
  cashflow          Float @default(0)
  cashflowAfterTax  Float @default(0)
  score             Int   @default(0)
}

model Offer {
  id              String   @id @default(cuid())
  createdAt       DateTime @default(now())

  propertyId      String   @unique
  property        Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  suggestedPrice  Int
  message         String
  model           String?
}

model Note {
  id          String   @id @default(cuid())
  createdAt   DateTime @default(now())

  propertyId  String
  property    Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  body        String
}

model MarketComparison {
  id          String       @id @default(cuid())
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  propertyId  String       @unique
  property    Property     @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  rentPerSqmLow    Float
  rentPerSqmHigh   Float
  pricePerSqmLow   Float
  pricePerSqmHigh  Float
  rating           MarketRating
  rationale        String
  dataCaveat       String
  model            String?
}

model AuctionInfo {
  id              String       @id @default(cuid())
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  propertyId      String       @unique
  property        Property     @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  auctionType     AuctionType  @default(ZVG)
  caseNumber      String?      // Aktenzeichen, z. B. "5K 123/24"
  marketValue     Int?         // Verkehrswert lt. Gutachten in EUR
  auctionDate     DateTime?    // Versteigerungstermin
  auctionLocation String?      // Amtsgericht / Plattform
  sourceUrl       String?      // Link zur Bekanntmachung / zum Termin
  rawText         String?      // Original-Bekanntmachungstext (max ein paar KB) zum Nachschlagen

  bidLimit        Int?         // Berechnetes Bietlimit (max Kaufpreis bei CF n. Steuer ≥ 0)
  bidLimitNeutral Int?         // Bietlimit für CF n. Steuer = 0 (Break-Even)
  notes           String?      // Auffälligkeiten aus der Extraktion
}
